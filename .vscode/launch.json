{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "python_process",
      "type": "pickString",
      "description": "Select the process to debug",
      "options": [
        "POC/convert_images.py",
        "POC/runner.py"
      ],
    },
    {
      "id": "args",
      "description": "Arguments to pass to the process",
      "type": "promptString"
    }
  ],
  "configurations": [
    {
      "name": "Python: Process",
      "type": "debugpy",
      "request": "launch",
      "program": "${input:python_process}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": "${input:args}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "C/C++: g++ build and debug active file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/system/test/module/vision_smoke_test",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/system/test/module/",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
    }
  ]
}